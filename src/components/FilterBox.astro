---
const { title, action, query, options, labels } = Astro.props;
---
<aside class="card filter">
  <h3>{title}</h3>
  <form method="get" action={action}>
    <div style="margin-bottom:12px">
      <label>{labels.search}</label>
      <input name="q" value={query.get("q") ?? ""} placeholder="e.g. Niacinamide, peptide..." />
    </div>

    {Object.entries(options).map(([k,vals]) => (
      <div style="margin-bottom:12px">
        <label>{k}</label>
        <select name={k}>
          <option value="">—</option>
          {(vals as string[]).map(v => <option value={v} selected={query.get(k)===v}>{v}</option>)}
        </select>
      </div>
    ))}

    <div style="display:flex;gap:10px;margin-top:8px">
      <button class="btn" type="submit" style="width:100%">{labels.apply}</button>
      <a class="btn ghost" href={action} style="width:100%">{labels.clear}</a>
    </div>
  </form>
</aside>
